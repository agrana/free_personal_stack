# APP-004 — public configuration vs secrets (names and placeholders only).
# Resolve real values from the authorized secure source via secrets-preflight.
# Do not commit .env files. Do not put production secrets into fork/PR previews.

# ---------------------------------------------------------------------------
# Public configuration (NEXT_PUBLIC_* strict allowlist only)
# Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY when nonempty; legacy anon is
# blank fallback. Modern publishable and legacy anon JWT may differ for the
# same project. Never put service-role / sb_secret_* material in NEXT_PUBLIC_*.
# Public keys rely on database RLS — they are not service credentials.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Shared Supabase project (existing SavedTube project — reuse, do not create)
# Privileged service and DB keys are server-only (never browser / NEXT_PUBLIC).
# ---------------------------------------------------------------------------
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_PROJECT_ID=your-supabase-project-ref
SUPABASE_DATABASE_PASSWORD=your-supabase-database-password

# ---------------------------------------------------------------------------
# Vercel — reuse token/scope from SavedTube; each app needs a DISTINCT project
# Missing VERCEL_PROJECT_ID means blocked until initializer binds a new project.
# ---------------------------------------------------------------------------
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_TEAM_ID=your-vercel-team-id
SAVEDTUBE_VERCEL_PROJECT_ID=your-existing-savedtube-vercel-project-id
VERCEL_PROJECT_ID=your-new-app-vercel-project-id

# ---------------------------------------------------------------------------
# Other server-only secrets (preview defaults: disabled / least privileged)
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
TERRAFORM_STATE_PASSWORD=your-terraform-state-password
DOMAIN_NAME=arena.example.com

# Optional model key (reuse from shared source). Absence is allowed.
# Does NOT prove Codex or Decisions entitlement.
OPENAI_API_KEY=your-openai-api-key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth (optional; server-only secret)
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
