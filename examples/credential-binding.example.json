{
  "schemaVersion": 1,
  "appId": "example-app",
  "description": "APP-004 reusable binding plan for example-owner/example-app. Alias names and targets only — never secret values or plaintext env exports. Remapping prohibited (slot==alias).",
  "repository": {
    "owner": "example-owner",
    "name": "example-app"
  },
  "publicConfigAllowlist": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SITE_URL"
  ],
  "serverOnly": [
    "CLOUDFLARE_API_TOKEN",
    "GOOGLE_CLIENT_SECRET",
    "NEXTAUTH_SECRET",
    "OPENAI_API_KEY",
    "SUPABASE_ACCESS_TOKEN",
    "SUPABASE_DATABASE_PASSWORD",
    "SUPABASE_SERVICE_ROLE_KEY",
    "TERRAFORM_STATE_PASSWORD",
    "VERCEL_API_TOKEN"
  ],
  "optionalAliases": [
    "OPENAI_API_KEY"
  ],
  "previewDefaults": {
    "injectProductionSecrets": false,
    "credentials": "disabled"
  },
  "forkPolicy": {
    "injectProductionSecrets": false
  },
  "identityChecks": {
    "savedtubeVercelProjectIdAlias": "SAVEDTUBE_VERCEL_PROJECT_ID",
    "appVercelProjectIdAlias": "VERCEL_PROJECT_ID",
    "rule": "App Vercel project ID must be distinct; missing app ID is blocked until initializer binds a new project (this plan does not create one)."
  },
  "readiness": {
    "localMetadataOk": "caller-dependent",
    "productionReady": false,
    "deploymentAuthorized": false,
    "note": "Unverified capabilities never authorize deployment; live supervisor checks remain outstanding."
  },
  "bindings": [
    {
      "slot": "VERCEL_API_TOKEN",
      "alias": "VERCEL_API_TOKEN",
      "source": "shared-savedtube-secure-store",
      "target": "example-app-process",
      "reuse": true,
      "status": "bind-from-shared",
      "persist": false
    },
    {
      "slot": "VERCEL_PROJECT_ID",
      "alias": "VERCEL_PROJECT_ID",
      "source": "example-app-new-project",
      "target": "example-app-process",
      "reuse": false,
      "status": "unbound",
      "persist": false
    },
    {
      "slot": "SAVEDTUBE_VERCEL_PROJECT_ID",
      "alias": "SAVEDTUBE_VERCEL_PROJECT_ID",
      "source": "shared-savedtube-identity",
      "target": "example-app-process",
      "reuse": true,
      "status": "reference-only",
      "persist": false
    },
    {
      "slot": "SUPABASE_URL",
      "alias": "SUPABASE_URL",
      "source": "shared-savedtube-secure-store",
      "target": "example-app-process",
      "reuse": true,
      "status": "bind-from-shared",
      "persist": false
    },
    {
      "slot": "SUPABASE_ANON_KEY",
      "alias": "SUPABASE_ANON_KEY",
      "source": "shared-savedtube-secure-store",
      "target": "example-app-process",
      "reuse": true,
      "status": "bind-from-shared",
      "persist": false
    },
    {
      "slot": "SUPABASE_SERVICE_ROLE_KEY",
      "alias": "SUPABASE_SERVICE_ROLE_KEY",
      "source": "shared-savedtube-secure-store",
      "target": "example-app-process",
      "reuse": true,
      "status": "bind-from-shared",
      "persist": false,
      "serverOnly": true
    },
    {
      "slot": "SUPABASE_ACCESS_TOKEN",
      "alias": "SUPABASE_ACCESS_TOKEN",
      "source": "shared-savedtube-secure-store",
      "target": "example-app-process",
      "reuse": true,
      "status": "bind-from-shared",
      "persist": false,
      "serverOnly": true
    },
    {
      "slot": "SUPABASE_PROJECT_ID",
      "alias": "SUPABASE_PROJECT_ID",
      "source": "shared-savedtube-secure-store",
      "target": "example-app-process",
      "reuse": true,
      "status": "bind-from-shared",
      "persist": false
    },
    {
      "slot": "OPENAI_API_KEY",
      "alias": "OPENAI_API_KEY",
      "source": "shared-savedtube-secure-store",
      "target": "example-app-process",
      "reuse": true,
      "status": "optional-bind-from-shared",
      "persist": false,
      "optional": true,
      "notes": "Optional. Presence does not prove Codex or Decisions entitlement."
    },
    {
      "slot": "CLOUDFLARE_API_TOKEN",
      "alias": "CLOUDFLARE_API_TOKEN",
      "source": "shared-savedtube-secure-store",
      "target": "example-app-process",
      "reuse": true,
      "status": "bind-from-shared",
      "persist": false
    },
    {
      "slot": "TERRAFORM_STATE_PASSWORD",
      "alias": "TERRAFORM_STATE_PASSWORD",
      "source": "shared-savedtube-secure-store",
      "target": "example-app-process",
      "reuse": true,
      "status": "bind-from-shared",
      "persist": false,
      "serverOnly": true
    }
  ]
}
