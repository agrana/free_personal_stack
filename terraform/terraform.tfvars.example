# APP-002 safe defaults for a single existing shared Supabase project.
# Copy to terraform.tfvars (gitignored). Do not commit secrets.

# Required per-app ownership (no shared reusable defaults)
approved_hostname     = "arena.example.com"
vercel_project_name   = "agent-arena"
deployment_state_key  = "agent-arena"
github_repo           = "example-owner/agent-arena"

# DNS: default disabled / fail closed. CloudFront is NOT implemented here.
enable_dns   = false
dns_provider = "unresolved"
# When enabling Cloudflare DNS later:
# enable_dns            = true
# dns_provider          = "cloudflare"
# cloudflare_zone_name  = "example.com"  # existing shared zone (data lookup only)
# app_url               = "agent-arena.vercel.app"
# cloudflare_api_token  = "..."

# Shared zone / mail: must stay off
create_cloudflare_zone = false
enable_email_routing   = false

# Shared Supabase project — reference only; never delete via Terraform
supabase_url               = "https://your-shared-project.supabase.co"
# Prefer modern publishable; legacy anon remains compatible and may differ.
# Prefer one writer (integration or Terraform) per app-scoped env binding.
# Never map service-role / sb_secret_* into public env bindings.
supabase_publishable_key   = "your-supabase-publishable-key"
# supabase_anon_key        = "your-supabase-anon-key"
supabase_service_role_key  = "your-supabase-service-role-key"
supabase_project_id        = "your-shared-project-id"
enable_supabase_project_deletion = false

vercel_api_token = "your-vercel-api-token"
vercel_team_id   = ""

site_url = "https://arena.example.com"
