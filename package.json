{
  "name": "personal-project-template",
  "version": "1.0.0",
  "description": "A template for quickly starting new personal projects with infrastructure setup",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"No tests specified yet\" && exit 0",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-commit-full": "./scripts/pre-commit-check.sh",
    "terraform:fmt": "cd terraform && terraform fmt -recursive",
    "terraform:fmt-check": "cd terraform && terraform fmt -check -recursive",
    "terraform:validate": "cd terraform && terraform validate",
    "terraform:security": "cd terraform && terraform plan -detailed-exitcode",
    "terraform:docs": "cd terraform && terraform-docs markdown . > README.md",
    "setup": "./scripts/setup.sh",
    "setup:local": "./scripts/setup-local.sh",
    "check:secrets": "./scripts/check-secrets.sh",
    "terraform:init": "cd terraform && terraform init -backend=false",
    "terraform:plan": "cd terraform && terraform plan",
    "terraform:apply": "node -e \"console.error('DISABLED by APP-002: apply blocked until APP-005 plan guard + remote verification'); process.exit(1)\"",
    "terraform:destroy": "node -e \"console.error('DISABLED by APP-002: destroy blocked (shared project safety)'); process.exit(1)\"",
    "terraform:status": "./scripts/quick-start.sh status",
    "infra:plan": "./scripts/quick-start.sh plan",
    "infra:apply": "node -e \"console.error('DISABLED by APP-002: infra apply blocked until APP-005'); process.exit(1)\"",
    "infra:destroy": "node -e \"console.error('DISABLED by APP-002: infra destroy blocked'); process.exit(1)\"",
    "db:reset": "node -e \"console.error('DISABLED by APP-002: database reset against shared Supabase is forbidden'); process.exit(1)\"",
    "db:migrate": "node -e \"console.error('DISABLED: unattended shared DB migrations stay off after APP-003; use scripts/migrate_app_namespace.sh with explicit --database-url and --local-disposable-only (or reviewed APP003_ALLOW_NON_LOCAL=1)'); process.exit(1)\"",
    "db:migrate:app": "./scripts/migrate_app_namespace.sh",
    "db:seed": "node -e \"console.error('DISABLED by APP-002: database seed against shared Supabase is forbidden'); process.exit(1)\"",
    "plan:guard": "./scripts/validate-terraform-plan.sh"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@supabase/supabase-js": "^2.38.0",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/auth-helpers-react": "^0.4.2",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "typescript": "^5.0.0",
    "supabase": "^1.123.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "@commitlint/cli": "^18.0.0",
    "@commitlint/config-conventional": "^18.0.0"
  },
  "keywords": [
    "template",
    "terraform",
    "infrastructure",
    "vercel",
    "supabase",
    "cloudflare",
    "personal-projects",
    "nextjs"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/free_personal_stack.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/free_personal_stack/issues"
  },
  "homepage": "https://github.com/your-username/free_personal_stack#readme",
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "terraform/**/*.tf": [
      "terraform fmt -recursive",
      "terraform validate"
    ],
    "terraform/**/*.tfvars": [
      "terraform fmt -recursive"
    ]
  }
}
